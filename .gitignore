# ==========================================
# 1. OS & Editor Specific Files
# ==========================================
.DS_Store
Thumbs.db
*.swp
*~

# VS Code settings & workspace files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA settings
.idea/
*.iws
*.iml
*.ipr

# Eclipse settings
.settings/
.classpath
.project
.factorypath

# ==========================================
# 2. Frontend / Node / React (Vite / CRA)
# ==========================================
# Dependencies (NEVER commit node_modules)
**/node_modules/
**/jspm_packages/

# Production builds
**/dist/
**/build/
**/out/

# Node environment & local variables
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Logs and debug output
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Framework cache
**/.vite/
**/.eslintcache

# ==========================================
# 3. Backend / Java / Spring Boot
# ==========================================
# Compiled Java outputs & dependencies
**/target/
**/bin/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.zip
**/*.tar.gz
**/*.rar

# Gradle build output (if using Gradle instead of Maven)
**/.gradle/
**/build/

# Spring Boot logs & temporary files
**/logs/
**/*.log
**/tmp/

# Local configuration overrides (e.g., secrets, local DB passwords)
**/src/main/resources/application-local.properties
**/src/main/resources/application-local.yml

